        {
          "name": "Finds Pets by status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pet/findByStatus?status=pending,sold,available",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet",
